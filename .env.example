# Application Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://etfago:etfago_dev_password@localhost:5434/etfago

# Authentication (Auth.js)
AUTH_SECRET=dev-secret-change-in-production-min-32-chars-long
AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# Email / Notifications (Resend / Mock adapter)
RESEND_API_KEY=re_placeholder_for_development
EMAIL_FROM=Etfago <no-reply@example.com>

# Private Server Storage (VPS Persistent Filesystem)
# In production on VPS: /data/etfago/private-files (mounted to host /srv/etfago/private-files)
STORAGE_ROOT=./storage/private-files
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_STORAGE_BYTES=209715200

# Logging
LOG_LEVEL=info
